      </link>

      <!-- ======================================================
           内墙：横墙 y = 2.5（分隔上排卧室与下排空间）
           ===================================================== -->
      <link name="wall_divider_y_west">
        <pose>-9.0 2.5 1.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.0 0.15 3.0</size>
