      <link name="tv_stand">
        <pose>8 -6 0.3 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.4 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.25 0.2 1</ambient>
            <diffuse>0.3 0.25 0.2 1</diffuse>
