          <surface>
            <friction>
              <ode>
                <mu>0.6</mu>
                <mu2>0.6</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
      </link>
    </model>

    <!-- ==================== 启动相机（可选） ==================== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-15 -15 12 0 0.8 0.9</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>